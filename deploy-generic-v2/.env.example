# =============================================================================
# PhishForge -- production env template (deploy-generic-v2).
#
# Copy this file to .env (which is gitignored) and fill in real values.
# Docker Compose reads it automatically when you run `docker compose up`
# from this directory.
#
#   cp .env.example .env
#   chmod 600 .env
#   nano .env
#
# NEVER commit a real .env. Rotate SECRET_KEY on every deploy.
# =============================================================================

# -----------------------------------------------------------------------------
# MySQL -- used by the `db` container AND threaded into the backend's
# DATABASE_URL via docker-compose.yml.
# Generate strong passwords with `openssl rand -base64 32`.
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=replace-me-root-password
MYSQL_DATABASE=phishforge
MYSQL_USER=phishforge_app
MYSQL_PASSWORD=replace-me-app-password

# -----------------------------------------------------------------------------
# Backend -- direct DATABASE_URL override.
#
# By default the compose file assembles this from MYSQL_USER / MYSQL_PASSWORD /
# MYSQL_DATABASE above, so you can leave this commented. Uncomment + edit only
# if you need to point the backend at a managed DB instead of the bundled
# MySQL container.
# -----------------------------------------------------------------------------
# DATABASE_URL=mysql+aiomysql://phishforge_app:<password>@db:3306/phishforge

# -----------------------------------------------------------------------------
# Backend -- secrets.
# -----------------------------------------------------------------------------
# JWT signing key. ROTATE on every deploy -- rotation invalidates outstanding
# tokens (forces re-login). Generate with:  openssl rand -hex 64
SECRET_KEY=replace-me-with-openssl-rand-hex-64

# Anthropic API key -- required. The app boots without it but every /generate
# call returns 500. Get one from https://console.anthropic.com/.
ANTHROPIC_API_KEY=sk-ant-replace-me

# OpenAI API key -- OPTIONAL. Powers the Asset Library image generation.
# The app boots fine without it; image-generation endpoints return 503 if
# called while unset. Get one from https://platform.openai.com/.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# JWT lifetime in minutes (default 120 = 2h).
ACCESS_TOKEN_EXPIRE_MINUTES=120

# -----------------------------------------------------------------------------
# Backend -- public-facing URLs.
#
# PUBLIC_BACKEND_URL is baked into exported HTML for asset/logo URLs so
# external recipients can fetch /static/brand/... images. It MUST be the
# externally-reachable backend origin.
#
# FRONTEND_URL is used to build /share/<token> preview links handed to
# stakeholders. It MUST be the externally-reachable SPA origin.
# -----------------------------------------------------------------------------
PUBLIC_BACKEND_URL=https://api.example.com
FRONTEND_URL=https://app.example.com

# -----------------------------------------------------------------------------
# Backend -- CORS.
#
# Comma-separated list of origins permitted to call /api/*. At minimum this
# must include FRONTEND_URL; add a staging origin (or localhost during
# debugging) if you need to. Wildcards are NOT supported.
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=https://app.example.com

# -----------------------------------------------------------------------------
# Host port mapping.
#
# Published host ports for the SPA (nginx :80) and backend (uvicorn :8000).
# Defaults are 8182 / 8001. Override when co-hosting next to another stack
# that already holds those ports. PUBLIC_BACKEND_URL / FRONTEND_URL /
# ALLOWED_ORIGINS above MUST carry the matching port.
# -----------------------------------------------------------------------------
FRONTEND_PORT=8182
BACKEND_PORT=8001

# -----------------------------------------------------------------------------
# Backend -- refiner model.
# 'haiku' (default; cheap+fast) or 'sonnet' (higher quality).
# -----------------------------------------------------------------------------
REFINER_MODEL=haiku

# -----------------------------------------------------------------------------
# Optional -- LangSmith tracing.
# Leave LANGSMITH_API_KEY empty to disable tracing entirely.
# -----------------------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=phishforge-prod

# -----------------------------------------------------------------------------
# Misc.
# -----------------------------------------------------------------------------
TZ=Asia/Kolkata
